# =========================================
# Dados (os CSVs do ProUni podem ser grandes)
# =========================================
data/raw/*
data/processed/*
data/interim/*
data/external/*
!data/**/.gitkeep

*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.zip
*.rar
*.7z

# =========================================
# Python
# =========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# =========================================
# Ambientes virtuais
# =========================================
venv/
.venv/
env/
.env/
ENV/
.conda/
.vprouni/

# =========================================
# Variáveis de ambiente e credenciais
# =========================================
.env
.env.*
!.env.example
*.key
secrets.*

# =========================================
# Jupyter Notebook
# =========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# =========================================
# Saídas geradas (gráficos, relatórios, modelos)
# =========================================
reports/figures/*
!reports/figures/.gitkeep
models/*
!models/.gitkeep
*.log

# =========================================
# Testes e cobertura
# =========================================
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# =========================================
# IDEs e editores
# =========================================
.vscode/
.idea/
*.swp
*.swo

# =========================================
# Sistema operacional
# =========================================
.DS_Store
Thumbs.db
desktop.ini